DATABASE_URL="mysql://stockflow:local_password@127.0.0.1:3306/stockflow"
APP_URL="http://localhost:3000"
SESSION_TTL_SECONDS="604800"
DB_CONNECTION_LIMIT="5"
# Production: enable verified TLS; optionally supply your provider's CA path.
DB_SSL="false"
# Defaults to true only for loopback databases outside production without TLS.
# Production should use DB_SSL=true. Override only for a trusted database.
# DB_ALLOW_PUBLIC_KEY_RETRIEVAL="false"
# DB_SSL_CA_FILE="/run/secrets/mysql-ca.pem"
